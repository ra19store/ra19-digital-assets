# Cloudflare Pages redirects
# https://developers.cloudflare.com/pages/configuration/redirects/
#
# IMPORTANT: never redirect TO a ".html" path — Cloudflare Pages strips ".html"
# from URLs (pretty URLs) and would create a 308 loop. Redirect legacy paths to
# their new *extensionless* location instead.

# Old flat legal pages -> new legal/ folder
/terms.html          /legal/terms          301
/privacy.html        /legal/privacy        301
/refunds.html        /legal/refunds        301
/terms               /legal/terms          301
/privacy             /legal/privacy        301
/refunds             /legal/refunds        301

# Convenience aliases (note: do NOT add "/support -> /support": Pages already
# serves /support from support.html, and a self-redirect would loop)
/contact             /support              301
/products            /catalog              301
